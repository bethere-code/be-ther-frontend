# PRODUCTION API. Release builds (Play AAB / App Store) always load this file.
# Debug builds load it unless started with --dart-define=APP_ENV=dev (see dev.env).
API_BASE_URL=https://be-ther.com/api/
# Public web origin for share links (Open Graph previews). No trailing slash.
SHARE_BASE_URL=https://be-ther.com 
#API_BASE_URL=http://192.168.1.23:3000

# Web client ID from Google Cloud Console (OAuth 2.0 Client IDs).
GOOGLE_WEB_CLIENT_ID=894573927414-nat9nvjc04q9l6lfqjdq0d45jugmjii0.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=894573927414-mp9bnnqnj5j7md1i25se7tgeg3ghdlk9.apps.googleusercontent.com

# Minutes after event start before it is treated as a past event (feed/explore/profile/search).
EVENT_PAST_GRACE_MINUTES=60

